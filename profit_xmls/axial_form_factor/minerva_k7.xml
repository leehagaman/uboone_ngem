<?xml version="1.0" ?>

<mode name="nu" />

<detector name="uBooNE" pot="9.3221e19"/>

<channel name="numuCC1p" plotname="log10(Q^2 / GeV^2) vs. p_n">
	<bins2D
		unit="log10(Q^2 / GeV^2);p_n"
		edgesx="-2.00 -1.16 -0.94 -0.80 -0.68 -0.57 -0.47 -0.34 -0.25 0.20"
		edgesy="0.00 0.125 0.175 0.25 0.30 0.40 0.525 0.625 1.00"
	/>
	
	<bins2D
		unit="True log10(Q^2 / GeV^2);Reco log10(Q^2 / GeV^2)"
		edgesx="-2.00 -1.16 -0.94 -0.80 -0.68 -0.57 -0.47 -0.34 -0.25 0.20"
		edgesy="-2.00 -1.16 -0.94 -0.80 -0.68 -0.57 -0.47 -0.34 -0.25 0.20"
		plot="false"
	/>

	<bins unit="True Q^2 [GeV^2]" min="0" max="2" nbins="20" plot="false"/>
	<bins unit="True Neutrino Energy [MeV]" min="0" max="3000" nbins="20" plot="false"/>
	<bins unit="True L/E" min="0" max="3000" nbins="150" plot="false"/>

	<subchannel name="numuCC1poverlay" plotname="#nu_{#mu}CC1p overlay" color="#21b1ff"/>
	<subchannel name="nonnumuCC1poverlay" plotname="non-#nu_{#mu}CC1p overlay" color="#ff9f21"/>
</channel>

<model tag="nullmodel">
    <rule index="0" name="No Osc"/>
</model>

<MCFile treename="tree" filename="/nevis/riverside/data/epelaez/ngem/intermediate_files/minimal_withspline_df.root" pot="9.3221e19">

	<branch
        	associated_subchannel = "nu_uBooNE_numuCC1p_numuCC1poverlay"
        	model_rule            = "0"
			weight_1              = "isdata==0 && isext==0 && isdirt==0 && isnuwro==0 && afro_1mu1p_sel==1 && afro_1mu1p_true==1"
			weight_2              = "non_genie_net_weight"
			weight_3              = "weight_minerva_hydrogen_k7_FA"
		>
		<variable2D>log10(afro_1mu1p_Q2);afro_1mu1p_Pn</variable2D>
		<variable2D>log10(GTruth_gQ2);log10(afro_1mu1p_Q2)</variable2D>
		<variable>GTruth_gQ2</variable>
		<variable>truth_nuEnergy</variable>
		<variable>1000.*(mcflux_dk2gen + mcflux_gen2vtx)/truth_nuEnergy</variable>
	</branch>
	<branch
        	associated_subchannel = "nu_uBooNE_numuCC1p_nonnumuCC1poverlay"
        	model_rule            = "0"
			weight_1              = "isdata==0 && isext==0 && isdirt==0 && isnuwro==0 && afro_1mu1p_sel==1 && afro_1mu1p_true==0"
			weight_2              = "non_genie_net_weight"
			weight_3              = "weight_minerva_hydrogen_k7_FA"
		>
		<variable2D>log10(afro_1mu1p_Q2);afro_1mu1p_Pn</variable2D>
		<variable2D>log10(GTruth_gQ2);log10(afro_1mu1p_Q2)</variable2D>
		<variable>GTruth_gQ2</variable>
		<variable>truth_nuEnergy</variable>
		<variable>1000.*(mcflux_dk2gen + mcflux_gen2vtx)/truth_nuEnergy</variable>
	</branch>
</MCFile>

<!-- Detector variations in two CV groups (uboone_ngem df_helpers.detvar_weight_col, 2026-11-04 dataframes):
     LY and WireMod are matched against the main CV (runs 1, 3 with the 3b 1mil sample, and 5), SCE and
     Recomb2 against the CV of the 3b 500k sample (runs 1, 3 and 5). Within a section the CV keys
     (filetype_code, run, subrun, event) are unique; filetype_code separates nu_overlay from nue_overlay.
     WireModThetaYZ has no run 3 sample; the Recomb2 run 5 sample has 65 % of the CV POT. -->
<DetVarFiles>
	<DetVarSection treename="tree" include_only_weights="1" extra_weight="net_weight" cv_variation_matching_vars="filetype_code,run,subrun,event">

		<cv filename="/nevis/riverside/data/epelaez/ngem/intermediate_files/minimal_detvar_CV_df.root" pot="1" />

		<variation name="LYAtt" filename="/nevis/riverside/data/epelaez/ngem/intermediate_files/minimal_detvar_LYAtt_df.root" pot="1" />
		<variation name="LYDown" filename="/nevis/riverside/data/epelaez/ngem/intermediate_files/minimal_detvar_LYDown_df.root" pot="1" />
		<variation name="LYRayleigh" filename="/nevis/riverside/data/epelaez/ngem/intermediate_files/minimal_detvar_LYRayleigh_df.root" pot="1" />
		<variation name="WireModX" filename="/nevis/riverside/data/epelaez/ngem/intermediate_files/minimal_detvar_WireModX_df.root" pot="1" />
		<variation name="WireModYZ" filename="/nevis/riverside/data/epelaez/ngem/intermediate_files/minimal_detvar_WireModYZ_df.root" pot="1" />
		<variation name="WireModThetaXZ" filename="/nevis/riverside/data/epelaez/ngem/intermediate_files/minimal_detvar_WireModThetaXZ_df.root" pot="1" />
		<variation name="WireModThetaYZ" filename="/nevis/riverside/data/epelaez/ngem/intermediate_files/minimal_detvar_WireModThetaYZ_df.root" pot="1" />

		<subchannel>nu_uBooNE_numuCC1p_numuCC1poverlay</subchannel>
		<subchannel>nu_uBooNE_numuCC1p_nonnumuCC1poverlay</subchannel>

	</DetVarSection>

	<DetVarSection treename="tree" include_only_weights="1" extra_weight="net_weight" cv_variation_matching_vars="filetype_code,run,subrun,event">

		<cv filename="/nevis/riverside/data/epelaez/ngem/intermediate_files/minimal_detvar_CV_sce_recomb2_df.root" pot="1" />

		<variation name="Recomb2" filename="/nevis/riverside/data/epelaez/ngem/intermediate_files/minimal_detvar_Recomb2_df.root" pot="1" />
		<variation name="SCE" filename="/nevis/riverside/data/epelaez/ngem/intermediate_files/minimal_detvar_SCE_df.root" pot="1" />

		<subchannel>nu_uBooNE_numuCC1p_numuCC1poverlay</subchannel>
		<subchannel>nu_uBooNE_numuCC1p_nonnumuCC1poverlay</subchannel>

	</DetVarSection>
</DetVarFiles>

